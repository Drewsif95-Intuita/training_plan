# Load with: node --env-file=.env src/server.mjs
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DATA_DIR=./data
# Generate locally with: npm run manage -- password-hash
# Store only the hash in Railway. Never paste a real password or API token into chat.
AUTH_PASSWORD_HASH=
# Required in production: DATA_DIR must be inside this Railway volume mount.
# RAILWAY_VOLUME_MOUNT_PATH is supplied by Railway after a volume is mounted.
# Create a Personal API token with activityRead + bodyvaluesRead in Tredict.
# Add it directly to Railway's private variables, never to Git or chat.
# A configured token enables a refresh on startup (when due) and every 24 hours.
TREDICT_TOKEN=
TREDICT_SYNC_ENABLED=true
